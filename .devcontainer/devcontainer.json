{
    "name": "mini-dpvo",
    "privileged": true,
    "remoteUser": "${env:USER}",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "${env:USER}",
            "CONTAINER_ID": "mini-dpvo"
        }
    },
    "workspaceFolder": "/home/${env:USER}/mini-dpvo",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/${env:USER}/mini-dpvo,type=bind",
    "runArgs": [
        "--net=host",
        "--pid=host",
        "--ipc=host",
        "-e", "DISPLAY=${env:DISPLAY}"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "3xpo.regionfolding",
                "llvm-vs-code-extensions.vscode-clangd",
                "mechatroner.rainbow-csv",
                "ms-python.debugpy",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.vscode-python-envs",
                "tomoki1207.pdf",
                "twxs.cmake",
                "Anthropic.claude-code"
            ]
        }
    },
    "mounts": [
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached",
        "source=/dev/kfd,target=/dev/kfd,type=bind,consistency=cached",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached",
        "type=bind,source=/home/${localEnv:USER}/.ssh,target=/home/${env:USER}/.ssh,readonly",
        "type=bind,source=/home/${localEnv:USER}/.dotfiles,target=/home/${env:USER}/.dotfiles,readonly",
        "type=bind,source=/home/${localEnv:USER}/Datasets,target=/home/${env:USER}/datasets"
    ]
}
